<Project>
  <!--
    Epic-013 Deployment Foundation: the one supported publish shape for VSP, a self-contained
    win-x64 folder with the .NET/WPF runtime bundled, so a clean Windows machine needs nothing
    preinstalled. No single-file, ReadyToRun, or AOT (out of Epic-013 scope, and single-file
    packaging would complicate the ffmpeg\win-x64 folder-based native loader for no benefit here).

    Usage: dotnet publish VSP.UI\VSP.UI.csproj -c Release /p:PublishProfile=win-x64
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
