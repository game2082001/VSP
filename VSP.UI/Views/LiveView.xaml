<UserControl x:Class="VSP.UI.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:helpers="clr-namespace:VSP.UI.Helpers"
             Background="#1E1E1E">

    <UserControl.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Select a camera from the Camera Workspace to begin."
                       Foreground="#B0B0B0"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasCamera, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <Image Source="{Binding CurrentFrameSource}"
                   Stretch="Uniform"
                   Visibility="{Binding HasCamera, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding HasCamera, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10"
                             Fill="#E51400"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="REC"
                               Foreground="#E51400"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Play"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding PlayCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Pause"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding PauseCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Resume"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResumeCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StopCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Start Recording"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StartRecordingCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop Recording"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StopRecordingCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
