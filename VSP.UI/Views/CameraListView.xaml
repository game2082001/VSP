<UserControl x:Class="VSP.UI.Views.CameraListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VSP.UI.Views"
             xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             Background="#1E1E1E">

    <UserControl.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Discovery"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowDiscoveryCommand}"
                            Visibility="{Binding IsShowingCameraList, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0"/>
                    <Button Content="Camera List"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowCameraListCommand}"
                            Visibility="{Binding IsShowingDiscovery, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{Binding IsShowingCameraList, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource VspTextBox}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Content="Search"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}"
                        Margin="0,0,8,0"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding BrandOptions}"
                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                          Style="{StaticResource VspComboBox}"
                          Margin="0,0,8,0"/>

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          Style="{StaticResource VspComboBox}"
                          Margin="0,0,8,0"/>

                <Button Grid.Column="5"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="6"
                        Content="Import"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportCommand}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="7"
                        Content="Add Camera"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCameraCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                Visibility="{Binding IsShowingCameraList, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedItemCount, StringFormat='{}{0} selected'}"
                           Foreground="#B0B0B0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="View Live"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ViewLiveCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Export"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Batch Test"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BatchConnectionTestCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Batch Edit"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BatchEditCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,12"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{Binding IsShowingCameraList, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid ItemsSource="{Binding Cameras}"
                      SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                      MouseDoubleClick="HandleCameraRowDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select"
                                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"/>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="180"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="IP Address"
                                        Binding="{Binding IpAddress}"
                                        Width="160"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Brand"
                                        Binding="{Binding Brand}"
                                        Width="140"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="140"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Location"
                                        Binding="{Binding Location}"
                                        Width="*"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,12"
                Visibility="{Binding IsShowingDiscovery, Converter={StaticResource BoolToVisibilityConverter}}">
            <views:CameraDiscoveryView/>
        </Border>

        <Border Grid.Row="4"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,0"
                Visibility="{Binding IsShowingCameraList, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding TotalCamerasText}"
                           Foreground="#B0B0B0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#B0B0B0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
