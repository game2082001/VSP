<Window x:Class="VSP.UI.Views.ImportWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Import Wizard"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <Grid Grid.Row="1"
              Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource VspCard}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Steps"
                               Style="{StaticResource VspSectionTitle}"/>

                    <TextBlock Text="1. Select File"
                               Margin="0,16,0,8"
                               Foreground="White"/>
                    <TextBlock Text="2. Preview"
                               Margin="0,0,0,8"
                               Foreground="#B0B0B0"/>
                    <TextBlock Text="3. Import Result"
                               Foreground="#B0B0B0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource VspCard}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Framework Skeleton"
                               Style="{StaticResource VspSectionTitle}"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Current Step"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding CurrentStep}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                                   Text="File Name"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SelectedFileName, TargetNullValue=''}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                                   Text="File Type"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding SelectedFileType, TargetNullValue=''}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Margin="0,24,0,0"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Background="#202020">
                        <TextBlock Text="Preview and import execution are intentionally not implemented in Task-111A."
                                   TextWrapping="Wrap"
                                   Foreground="#B0B0B0"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#B0B0B0"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button Content="Browse"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding BrowseFileCommand}"/>

            <Button Content="Back"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding PreviousStepCommand}"/>

            <Button Content="Next"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding NextStepCommand}"/>

            <Button Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
