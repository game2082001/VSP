<Window x:Class="VSP.UI.Views.ImportWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Import Wizard"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource VspCard}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Import File"
                           Style="{StaticResource VspFieldLabel}"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SelectedFileName}"
                         IsReadOnly="True"
                         Style="{StaticResource VspTextBox}"
                         Margin="12,0,12,0"/>

                <Button Grid.Column="2"
                        Content="Browse"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseFileCommand}"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource VspCard}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Steps"
                               Style="{StaticResource VspSectionTitle}"/>

                    <TextBlock Text="1. Select File"
                               Margin="0,16,0,8"
                               Foreground="White"/>
                    <TextBlock Text="2. Preview"
                               Margin="0,0,0,8"
                               Foreground="White"/>
                    <TextBlock Text="3. Ready to Import"
                               Margin="0,0,0,16"
                               Foreground="White"/>

                    <TextBlock Text="Current Step"
                               Style="{StaticResource VspFieldLabel}"/>
                    <TextBlock Text="{Binding CurrentStep}"
                               Foreground="#B0B0B0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource VspCard}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Import Preview"
                               Style="{StaticResource VspSectionTitle}"/>

                    <Grid Margin="0,20,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="File Name"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedFileName}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="File Type"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SelectedFileType}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                                   Text="Total Rows"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding TotalRows}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="Valid Rows"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="{Binding ValidRows}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                                   Text="Invalid Rows"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding InvalidRows}"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding PreviewRows}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              MinHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row Number" Binding="{Binding RowNumber}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="140"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Messages" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="#B0B0B0"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button Content="Import"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding ImportCommand}"/>

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
