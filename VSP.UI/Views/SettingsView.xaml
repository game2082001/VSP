<UserControl x:Class="VSP.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">

    <Grid Background="{DynamicResource BrushBackground}">
        <StackPanel MaxWidth="480"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="32">

            <TextBlock Text="Settings"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       FontSize="28"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Recording Path"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="14"/>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource VspTextBox}"
                         Text="{Binding RecordingPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,4,0,4"
                        Click="BrowseRecordingPathButton_Click"/>
            </Grid>

            <TextBlock Text="Retention Days"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="14"
                       Margin="0,16,0,0"/>
            <TextBox Style="{StaticResource VspTextBox}"
                     Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Language"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="14"
                       Margin="0,16,0,0"/>
            <ComboBox Style="{StaticResource VspComboBox}"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage}"/>
            <TextBlock Text="Language has no effect on displayed text yet."
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="11"
                       Margin="0,2,0,0"/>

            <TextBlock Text="Theme"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="14"
                       Margin="0,16,0,0"/>
            <ComboBox Style="{StaticResource VspComboBox}"
                      ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme}"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,24,0,0">
                <Button Content="Save"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"/>

            <TextBlock Text="Database Backup / Restore"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="14"
                       Margin="0,32,0,0"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button Content="Backup Database..."
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackupCommand}"/>
                <Button Content="Restore Database..."
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding RestoreCommand}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
