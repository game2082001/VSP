<Window x:Class="VSP.UI.Views.BatchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Edit"
        Width="480"
        Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding SelectedCount, StringFormat='Editing {0} camera(s)'}"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1"
                Style="{StaticResource VspCard}"
                Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding ApplyBrand}" Content="Brand" Foreground="White" Width="120" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand, Mode=TwoWay}" Style="{StaticResource VspComboBox}" Width="220"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding ApplyLocation}" Content="Location" Foreground="White" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VspTextBox}" Width="220"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding ApplyUsername}" Content="Username" Foreground="White" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VspTextBox}" Width="220"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding ApplyPassword}" Content="Password" Foreground="White" Width="120" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ApplyPasswordBox" Style="{StaticResource VspPasswordBox}" Width="220" PasswordChanged="HandleApplyPasswordChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="#B0B0B0"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="2"
                    Content="Apply"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyCommand}"/>
        </Grid>
    </Grid>
</Window>
