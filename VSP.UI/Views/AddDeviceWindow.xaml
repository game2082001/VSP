<Window x:Class="VSP.UI.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Editor"
        Width="720"
        Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="56"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="56"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Camera Editor"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

		<ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

			<StackPanel>

				<!-- 基本資訊 -->
				<Border Style="{StaticResource VspCard}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="32"/>
							<RowDefinition Height="44"/>
							<RowDefinition Height="44"/>
							<RowDefinition Height="44"/>
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="24"/>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="基本資訊"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

						<TextBlock Text="名稱"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
						<TextBox x:Name="NameTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource VspTextBox}"/>

						<TextBlock Text="品牌"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
						<ComboBox x:Name="BrandComboBox"
                                  Grid.Row="1"
                                  Grid.Column="4"
                                  Style="{StaticResource VspComboBox}">
							<ComboBoxItem Content="Hikvision"/>
							<ComboBoxItem Content="Dahua"/>
							<ComboBoxItem Content="ONVIF"/>
							<ComboBoxItem Content="RTSP"/>
						</ComboBox>

						<TextBlock Text="IP"
                                   Grid.Row="2"
                                   Style="{StaticResource VspFieldLabel}"/>
						<TextBox x:Name="IpTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource VspTextBox}"/>

						<TextBlock Text="型號"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="ModelTextBox"
									Grid.Row="2"
									Grid.Column="4"
									Style="{StaticResource VspTextBox}"/>

                        <TextBlock Text="位置"
                                   Grid.Row="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="LocationTextBox"
									Grid.Row="3"
									Grid.Column="1"
									Grid.ColumnSpan="4"
									Style="{StaticResource VspTextBox}"/>
                    </Grid>
				</Border>

				<!-- 網路設定 -->
				<Border Style="{StaticResource VspCard}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="32"/>
							<RowDefinition Height="44"/>
							<RowDefinition Height="44"/>
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="24"/>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="網路設定"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

						<TextBlock Text="HTTP Port"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="HttpPortTextBox"
									Text="80"
									Grid.Row="1"
									Grid.Column="1"
									Style="{StaticResource VspTextBox}"/>

                        <TextBlock Text="RTSP Port"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="RtspPortTextBox"
									Text="554"
									Grid.Row="1"
									Grid.Column="4"
									Style="{StaticResource VspTextBox}"/>

                        <TextBlock Text="SDK Port"
                                   Grid.Row="2"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="SdkPortTextBox"
									Text="8000"
									Grid.Row="2"
									Grid.Column="1"
									Style="{StaticResource VspTextBox}"/>
                    </Grid>
				</Border>

				<!-- 登入資訊 -->
				<Border Style="{StaticResource VspCard}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="32"/>
							<RowDefinition Height="44"/>
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="24"/>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="登入資訊"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

						<TextBlock Text="帳號"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
						<TextBox x:Name="UsernameTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource VspTextBox}"/>

						<TextBlock Text="密碼"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
						<PasswordBox x:Name="PasswordBox"
                                     Grid.Row="1"
                                     Grid.Column="4"
                                     Style="{StaticResource VspPasswordBox}"/>
					</Grid>
				</Border>

				<!-- 串流設定 -->
				<Border Style="{StaticResource VspCard}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="32"/>
							<RowDefinition Height="44"/>
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="110"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="串流設定"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="2"/>

						<TextBlock Text="RTSP URL"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
						<TextBox x:Name="RtspTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource VspTextBox}"/>
					</Grid>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
			<Button Content="取消"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

			<Button Content="儲存"
                    Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click"/>
		</StackPanel>
	</Grid>
</Window>