<Window x:Class="VSP.UI.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Device"
        Width="720"
        Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Device"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource VspCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Basic Info"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

                        <TextBlock Text="Name"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBox x:Name="NameTextBox"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="NameErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Text="Brand"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <ComboBox x:Name="BrandComboBox"
                                  Grid.Row="1"
                                  Grid.Column="4"
                                  Style="{StaticResource VspComboBox}"
                                  SelectionChanged="ValidationSelectionChanged">
                            <ComboBoxItem Content="Hikvision"/>
                            <ComboBoxItem Content="Dahua"/>
                            <ComboBoxItem Content="ONVIF"/>
                            <ComboBoxItem Content="RTSP"/>
                        </ComboBox>

                        <TextBlock Text="IP Address"
                                   Grid.Row="2"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1">
                            <TextBox x:Name="IpTextBox"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="IpErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Text="Model"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="ModelTextBox"
                                 Grid.Row="2"
                                 Grid.Column="4"
                                 Style="{StaticResource VspTextBox}"
                                 TextChanged="ValidationInputChanged"/>

                        <TextBlock Text="Location"
                                   Grid.Row="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <TextBox x:Name="LocationTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource VspTextBox}"
                                 TextChanged="ValidationInputChanged"/>

                        <TextBlock Text="Connection Type"
                                   Grid.Row="3"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="3"
                                    Grid.Column="4">
                            <ComboBox x:Name="ConnectionTypeComboBox"
                                      Style="{StaticResource VspComboBox}"
                                      SelectionChanged="ValidationSelectionChanged">
                                <ComboBoxItem Content="HikvisionISAPI"/>
                                <ComboBoxItem Content="HikvisionSDK"/>
                                <ComboBoxItem Content="DahuaNetSDK"/>
                                <ComboBoxItem Content="ONVIF"/>
                                <ComboBoxItem Content="RTSP"/>
                                <ComboBoxItem Content="AxisVAPIX"/>
                            </ComboBox>
                            <TextBlock x:Name="ConnectionTypeErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource VspCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Network"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

                        <TextBlock Text="HTTP Port"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBox x:Name="HttpPortTextBox"
                                     Text="80"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="HttpPortErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Text="RTSP Port"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="4">
                            <TextBox x:Name="RtspPortTextBox"
                                     Text="554"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="RtspPortErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Text="SDK Port"
                                   Grid.Row="2"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1">
                            <TextBox x:Name="SdkPortTextBox"
                                     Text="8000"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="SdkPortErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource VspCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Credentials"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="5"/>

                        <TextBlock Text="Username"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBox x:Name="UsernameTextBox"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="UsernameErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock Text="Password"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Row="1"
                                     Grid.Column="4"
                                     Style="{StaticResource VspPasswordBox}"
                                     PasswordChanged="ValidationPasswordChanged"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource VspCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Streaming"
                                   Style="{StaticResource VspSectionTitle}"
                                   Grid.ColumnSpan="2"/>

                        <TextBlock Text="RTSP URL"
                                   Grid.Row="1"
                                   Style="{StaticResource VspFieldLabel}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBox x:Name="RtspTextBox"
                                     Style="{StaticResource VspTextBox}"
                                     TextChanged="ValidationInputChanged"/>
                            <TextBlock x:Name="RtspErrorTextBlock"
                                       Margin="2,4,0,0"
                                       Foreground="#FF6B6B"
                                       FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
