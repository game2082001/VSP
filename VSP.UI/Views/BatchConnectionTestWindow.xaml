<Window x:Class="VSP.UI.Views.BatchConnectionTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Connection Test"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Connection Test Results"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1"
                Style="{StaticResource VspCard}"
                Padding="16">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="160"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="#B0B0B0"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</Window>
