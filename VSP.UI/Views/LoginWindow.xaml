<Window x:Class="VSP.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VSP - Login"
        Width="360"
        Height="300"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="VSP Login"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Username" Style="{StaticResource VspFieldLabel}"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource VspTextBox}"/>

        <TextBlock Text="Password" Style="{StaticResource VspFieldLabel}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="PasswordBox"
                     Style="{StaticResource VspPasswordBox}"
                     PasswordChanged="HandlePasswordChanged"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <Button Content="Log In"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"/>
    </StackPanel>
</Window>
