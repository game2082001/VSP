<UserControl x:Class="VSP.UI.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBackground}">

    <Grid Background="{DynamicResource BrushBackground}" Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Change Password"
                   Foreground="{DynamicResource BrushTextPrimary}"
                   FontSize="28"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Width="360" HorizontalAlignment="Left">
            <TextBlock Text="Current Password" Style="{StaticResource VspFieldLabel}"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Style="{StaticResource VspPasswordBox}"
                         PasswordChanged="HandleCurrentPasswordChanged"/>

            <TextBlock Text="New Password" Style="{StaticResource VspFieldLabel}" Margin="0,10,0,0"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Style="{StaticResource VspPasswordBox}"
                         PasswordChanged="HandleNewPasswordChanged"/>

            <TextBlock Text="Confirm New Password" Style="{StaticResource VspFieldLabel}" Margin="0,10,0,0"/>
            <PasswordBox x:Name="ConfirmNewPasswordBox"
                         Style="{StaticResource VspPasswordBox}"
                         PasswordChanged="HandleConfirmNewPasswordChanged"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FF6B6B"
                       FontSize="12"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="12"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <Button Content="Change Password"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ChangePasswordCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
