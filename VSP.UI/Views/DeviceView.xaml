<UserControl x:Class="VSP.UI.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="#1E1E1E" Margin="16">

		<Grid.RowDefinitions>
			<RowDefinition Height="52"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Toolbar -->
		<DockPanel Grid.Row="0">
			<TextBlock Text="Device Manager"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
				<Button Content="新增" Width="80"/>
				<Button Content="編輯" Width="80"/>
				<Button Content="刪除" Width="80"/>
				<Button Content="測試連線" Width="100"/>
			</StackPanel>
		</DockPanel>

		<!-- Main Layout -->
		<Grid Grid.Row="1" Margin="0,12,0,0">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260"/>
				<ColumnDefinition Width="12"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Workspace Tree -->
			<Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="12">

				<TreeView Background="#252526"
                          Foreground="White"
                          BorderThickness="0">

					<TreeViewItem Header="Demo Workspace" IsExpanded="True">
						<TreeViewItem Header="Main Site" IsExpanded="True">
							<TreeViewItem Header="Building A" IsExpanded="True">
								<TreeViewItem Header="1F"/>
								<TreeViewItem Header="2F"/>
								<TreeViewItem Header="Parking"/>
							</TreeViewItem>
						</TreeViewItem>
					</TreeViewItem>

				</TreeView>
			</Border>

			<!-- Camera List -->
			<Border Grid.Column="2"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1">

				<DataGrid AutoGenerateColumns="False"
                          Background="#252526"
                          Foreground="White"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#252526"
                          BorderThickness="0">

					<DataGrid.Columns>
						<DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="180"/>
						<DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="160"/>
						<DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="140"/>
						<DataGridTextColumn Header="串流 URL" Binding="{Binding StreamUrl}" Width="*"/>
					</DataGrid.Columns>

				</DataGrid>
			</Border>

		</Grid>
	</Grid>
</UserControl>