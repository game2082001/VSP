<UserControl x:Class="VSP.UI.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VSP.UI.ViewModels"
             Background="#1E1E1E">

	<UserControl.DataContext>
		<vm:DeviceViewModel/>
	</UserControl.DataContext>

	<Grid Background="#1E1E1E" Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Device Manager"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

		<DataGrid Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False"
                  Background="#252526"
                  Foreground="White"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252526"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderBrush="#3E3E42"
                  BorderThickness="1">

			<DataGrid.Columns>
				<DataGridTextColumn Header="名稱"
                                    Binding="{Binding Name}"
                                    Width="200"/>

				<DataGridTextColumn Header="IP"
                                    Binding="{Binding IP}"
                                    Width="200"/>

				<DataGridTextColumn Header="品牌"
                                    Binding="{Binding Brand}"
                                    Width="200"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>