<Window x:Class="VSP.UI.Views.CameraDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:VSP.UI.ViewModels"
        Title="{Binding Title}"
        Width="920"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Window.Resources>
        <!--
            RelativeSource retargets the binding's Source to the ancestor Window element itself,
            not its DataContext, so the Path must say DataContext.IsEditMode explicitly, not
            just IsEditMode (which would look for a same-named property on the Window object,
            which doesn't exist, and silently never fire). This is required because these styles
            are reused, via BasedOn, inside DriverSettingTemplate below, where each element's own
            DataContext is a DriverSettingEditorViewModel item (no IsEditMode property), not this
            Window's CameraDetailViewModel.
        -->
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource VspTextBox}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Single generic template for every driver setting, regardless of which driver or
            key it represents. IsSensitive/ValueKind/IsValid all come from the bound
            DriverSettingEditorViewModel item (in turn driven entirely by DriverSettingDefinition
            metadata) - there is no per-driver or per-key branching here. IsEditMode is reached
            via RelativeSource back to this Window's own DataContext (CameraDetailViewModel),
            the standard WPF pattern for ambient state inside a nested DataTemplate.
        -->
        <DataTemplate x:Key="DriverSettingTemplate" DataType="{x:Type viewModels:DriverSettingEditorViewModel}">
            <StackPanel Margin="0,0,20,12" MinWidth="320">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource VspFieldLabel}"/>

                <TextBlock Text="{Binding DisplayValue}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}"/>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <PasswordBox Loaded="HandleSettingPasswordBoxLoaded"
                             PasswordChanged="HandleSettingPasswordChanged">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox" BasedOn="{StaticResource VspPasswordBox}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <TextBlock Text="{Binding ErrorMessage}" Margin="2,4,0,0" Foreground="#FF6B6B" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource VspCard}"
                Padding="16">
            <DockPanel>
                <TextBlock Text="{Binding HeaderTitle}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Content="Edit"
                        DockPanel.Dock="Right"
                        Command="{Binding EditCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource VspCard}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Style="{StaticResource VspFieldLabel}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DetailValueStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNameValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding NameError}" Margin="2,4,0,0" Foreground="#FF6B6B" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNameValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Brand" Style="{StaticResource VspFieldLabel}"/>
                    <Grid Grid.Column="3">
                        <TextBlock Text="{Binding Brand}" Foreground="White" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding BrandOptions}"
                                  SelectedItem="{Binding Brand}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource VspComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource VspFieldLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="{Binding Model}" Style="{StaticResource DetailValueStyle}"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="IP Address" Style="{StaticResource VspFieldLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Text="{Binding IpAddress}" Style="{StaticResource DetailValueStyle}"/>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIpAddressValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding IpAddressError}" Margin="2,4,0,0" Foreground="#FF6B6B" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIpAddressValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Connection Type" Style="{StaticResource VspFieldLabel}"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="{Binding ConnectionType}" Foreground="White" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding ConnectionTypeOptions}"
                                  SelectedItem="{Binding ConnectionType}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource VspComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!--
                        Every driver setting for the selected ConnectionType, rendered purely
                        from DriverSettings (which is itself built purely from
                        DriverSettingsDefinition) via the single DriverSettingTemplate above.
                        No driver- or key-specific XAML exists anywhere in this window.
                    -->
                    <ItemsControl Grid.Row="3"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  Margin="0,4,0,4"
                                  ItemsSource="{Binding DriverSettings}"
                                  ItemTemplate="{StaticResource DriverSettingTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Grid.Row="4" Text="Status" Style="{StaticResource VspFieldLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Recording" Style="{StaticResource VspFieldLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Recording}" Foreground="White" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="5" Text="Location" Style="{StaticResource VspFieldLabel}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1">
                        <TextBlock Text="{Binding Location}" Style="{StaticResource DetailValueStyle}"/>
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditableTextBoxStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Create Time" Style="{StaticResource VspFieldLabel}"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding CreateTime}" Foreground="White" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" Text="Last Modify Time" Style="{StaticResource VspFieldLabel}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastModifyTime}" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B0B0B0"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Test Connection"
                    Margin="0,0,10,0"
                    Command="{Binding TestConnectionCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2"
                    Content="Delete"
                    Margin="0,0,10,0"
                    Command="{Binding DeleteCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="3"
                    Content="Save"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"/>

            <Button Grid.Column="4"
                    Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</Window>
