<Window x:Class="VSP.UI.Views.ForcedPasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VSP - Change Password Required"
        Width="380"
        Height="380"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Change Password Required"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <TextBlock Text="You must set a new password before continuing."
                   Foreground="#B0B0B0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Current Password" Style="{StaticResource VspFieldLabel}"/>
        <PasswordBox x:Name="CurrentPasswordBox"
                     Style="{StaticResource VspPasswordBox}"
                     PasswordChanged="HandleCurrentPasswordChanged"/>

        <TextBlock Text="New Password" Style="{StaticResource VspFieldLabel}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="NewPasswordBox"
                     Style="{StaticResource VspPasswordBox}"
                     PasswordChanged="HandleNewPasswordChanged"/>

        <TextBlock Text="Confirm New Password" Style="{StaticResource VspFieldLabel}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="ConfirmNewPasswordBox"
                     Style="{StaticResource VspPasswordBox}"
                     PasswordChanged="HandleConfirmNewPasswordChanged"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#FF6B6B"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <Button Content="Change Password"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding ChangePasswordCommand}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"/>
    </StackPanel>
</Window>
