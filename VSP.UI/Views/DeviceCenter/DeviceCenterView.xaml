<UserControl x:Class="VSP.UI.Views.DeviceCenter.DeviceCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DockPanel>
                <TextBlock Text="Device Center"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DeviceCount, StringFormat={}{0} device(s)}"
                               Foreground="#B0B0B0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Content="Add Device"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Command="{Binding AddDeviceCommand}"/>

                    <Button Content="Edit Device"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Command="{Binding EditDeviceCommand}"/>

                    <Button Content="Delete"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteDeviceCommand}"/>

                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Device List"
                                   Style="{StaticResource VspSectionTitle}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource VspTextBox}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BrandOptions}"
                                      SelectedItem="{Binding SelectedBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource VspComboBox}"
                                      Margin="0,0,8,0"/>

                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding ConnectionOptions}"
                                      SelectedItem="{Binding SelectedConnection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource VspComboBox}"
                                      Margin="0,0,8,0"/>

                            <Button Grid.Column="3"
                                    Content="Search"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SearchCommand}"
                                    Margin="0,0,8,0"/>

                            <Button Grid.Column="4"
                                    Content="Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearSearchCommand}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="No camera data available."
                               Foreground="#707070"
                               FontSize="13"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Margin="0,12,0,0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="6"
                                        BorderBrush="#404040"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding Brand}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding IpAddress}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding ConnectionType}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Device Detail"
                               Style="{StaticResource VspSectionTitle}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.Name, TargetNullValue=-}" Foreground="White"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Brand" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Brand, TargetNullValue=-}" Foreground="White"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.Model, TargetNullValue=-}" Foreground="White"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="IP" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.IpAddress, TargetNullValue=-}" Foreground="White"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Connection" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.ConnectionType, TargetNullValue=-}" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#B0B0B0"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
