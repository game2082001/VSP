<UserControl x:Class="VSP.UI.Views.DeviceCenter.DeviceCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DockPanel>
                <TextBlock Text="Device Center"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DeviceCount, StringFormat={}{0} device(s)}"
                               Foreground="#B0B0B0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Content="Add Device"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Delete"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Device List"
                               Style="{StaticResource VspSectionTitle}"/>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="No camera data available."
                               Foreground="#707070"
                               FontSize="13"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Margin="0,12,0,0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="6"
                                        BorderBrush="#404040"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding Brand}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding IpAddress}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding ConnectionType}"
                                                   Foreground="#B0B0B0"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Device Editor"
                               Style="{StaticResource VspSectionTitle}"/>

                    <TextBlock Text="Editor placeholder."
                               Foreground="#B0B0B0"
                               FontSize="15"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#B0B0B0"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
