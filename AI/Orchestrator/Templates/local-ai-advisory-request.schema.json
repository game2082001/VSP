{
  "schemaVersion": "1.0",
  "type": "localAiAdvisoryRequestSchema",
  "required": [
    "schemaVersion",
    "taskId",
    "analysisType",
    "sourceSha",
    "approvedScope",
    "prohibitedScope",
    "acceptanceCriteria",
    "changedFiles",
    "reviewRubric",
    "bounds",
    "inputDigest"
  ],
  "allowedAnalysisTypes": [
    "repo",
    "pr-diff",
    "ci-log",
    "advisory-review"
  ],
  "bounds": {
    "maxApprovedScopeItems": 25,
    "maxProhibitedScopeItems": 25,
    "maxAcceptanceCriteriaItems": 40,
    "maxChangedFiles": 100,
    "maxBoundedDiffChars": 60000,
    "maxSelectedSourceSnippets": 25,
    "maxSelectedSourceSnippetChars": 4000,
    "maxSanitizedEvidenceItems": 30,
    "maxSanitizedEvidenceChars": 4000,
    "maxReviewRubricChars": 12000,
    "maxRequestBytes": 200000
  },
  "allowedTopLevelProperties": [
    "schemaVersion",
    "taskId",
    "analysisType",
    "sourceSha",
    "baseSha",
    "headSha",
    "approvedScope",
    "prohibitedScope",
    "acceptanceCriteria",
    "changedFiles",
    "boundedDiff",
    "selectedSourceSnippets",
    "sanitizedEvidence",
    "reviewRubric",
    "bounds",
    "inputDigest"
  ],
  "forbiddenTopLevelProperties": [
    "githubToken",
    "gitHubToken",
    "pat",
    "githubAppPrivateKey",
    "githubAppInstallationToken",
    "claudeOAuthToken",
    "productionCredentials",
    "databasePassword",
    "cameraCredentials",
    "env",
    "environment",
    "gitConfig",
    "repositoryFilesystem",
    "rawCiLogs",
    "repositoryWrite",
    "githubWrite",
    "mergeAuthorization",
    "releaseAuthorization",
    "remediationAuthorization"
  ]
}
