{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/game2082001/VSP/AI/Orchestrator/Templates/ai02-predecessor-descriptor.schema.json",
  "title": "AI02 immutable predecessor artifact descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "childTaskId",
    "phase",
    "sequence",
    "recoveryRepositorySha",
    "workflowId",
    "runId",
    "runAttempt",
    "artifactId",
    "artifactName",
    "githubArtifactDigest",
    "packageSha256",
    "manifestSha256",
    "ownedFiles",
    "validationResult",
    "parentAggregateStateDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "childTaskId": { "type": "string", "pattern": "^VSP-AI02-[A-Za-z0-9-]+$", "maxLength": 100 },
    "phase": { "enum": ["A1", "A2", "A3"] },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 3 },
    "recoveryRepositorySha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflowId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "runAttempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "artifactId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "artifactName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 200 },
    "githubArtifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ownedFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[\\x20-\\x7E]+$" },
          "mode": { "const": "100644" },
          "size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "validationResult": { "const": "PASS" },
    "parentAggregateStateDigest": {
      "oneOf": [
        { "const": "GENESIS" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    }
  }
}
